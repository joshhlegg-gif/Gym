# The app runs on Supabase Postgres through the transaction pooler (port 6543).
# Vercel opens a connection per serverless invocation, and the pooler is what
# keeps that from exhausting the database.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# The session pooler (port 5432). Migrations run here because the transaction
# pooler cannot hold the advisory locks a migration needs. Not used at runtime.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase, for the browser. Both are meant to be public: the publishable key
# identifies the project, it does not grant access. The secret key never
# appears here or anywhere else in the repository.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# The owner's account. Seeded so the first migration can create that row.
OWNER_EMAIL="you@example.com"

# The timezone that decides which calendar day a reading belongs to. Server
# rendering runs in UTC, so without this a late-evening weigh-in files against
# tomorrow.
APP_TIMEZONE="Australia/Melbourne"

# Shared secret for the Apple Shortcut's ingest route. Generate a long random
# string; set it in Vercel and in the Shortcut's request header.
SHORTCUT_INGEST_TOKEN="generate-a-long-random-string"
